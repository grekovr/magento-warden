<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                demo_pickupdelivery_point_listing.demo_pickupdelivery_point_listing_data_source
            </item>
        </item>
    </argument>

    <settings>
        <spinner>pickupdelivery_columns</spinner>
        <deps>
            <dep>demo_pickupdelivery_point_listing.demo_pickupdelivery_point_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="demo_pickupdelivery_point_listing_data_source"
                component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>

        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="demo_pickupdelivery_point_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <columns name="pickupdelivery_columns">
        <column name="entity_id">
            <settings>
                <label>ID</label>
                <filter>textRange</filter>
                <sorting>asc</sorting>
            </settings>
        </column>

        <column name="code">
            <settings>
                <label>Code</label>
                <filter>text</filter>
            </settings>
        </column>

        <column name="name">
            <settings>
                <label>Name</label>
                <filter>text</filter>
            </settings>
        </column>

        <column name="city">
            <settings>
                <label>City</label>
                <filter>text</filter>
            </settings>
        </column>

        <column name="address">
            <settings>
                <label>Address</label>
                <filter>text</filter>
            </settings>
        </column>

        <column name="is_active">
            <settings>
                <label>Active</label>
                <filter>select</filter>
            </settings>
        </column>

        <column name="sort_order">
            <settings>
                <label>Sort Order</label>
                <filter>textRange</filter>
            </settings>
        </column>
    </columns>
</listing>
