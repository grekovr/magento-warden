<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                demo_pickupdelivery_point_form.demo_pickupdelivery_point_form_data_source
            </item>
        </item>
        <item name="label" xsi:type="string" translate="true">
            Pickup Point
        </item>
        <item name="template" xsi:type="string">
            templates/form/collapsible
        </item>
    </argument>

    <settings>
        <buttons>
            <button name="save"
                    class="Demo\PickupDelivery\Block\Adminhtml\Point\Edit\SaveButton"/>

            <button name="back"
                    class="Demo\PickupDelivery\Block\Adminhtml\Point\Edit\BackButton"/>
        </buttons>
        <namespace>demo_pickupdelivery_point_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>
                demo_pickupdelivery_point_form.demo_pickupdelivery_point_form_data_source
            </dep>
        </deps>
    </settings>

    <dataSource name="demo_pickupdelivery_point_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">
                    Magento_Ui/js/form/provider
                </item>
            </item>
        </argument>

        <settings>
            <submitUrl path="demopickupdelivery/point/save"/>
        </settings>

        <dataProvider class="Demo\PickupDelivery\Ui\DataProvider\Point\DataProvider"
                      name="demo_pickupdelivery_point_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General Information</label>
        </settings>

        <field name="code" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Code</label>
                <dataScope>code</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="name" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="city" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">City</label>
                <dataScope>city</dataScope>
            </settings>
        </field>

        <field name="address" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Address</label>
                <dataScope>address</dataScope>
            </settings>
        </field>

        <field name="is_active" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
                <dataScope>is_active</dataScope>
                <prefer>toggle</prefer>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>

        <field name="sort_order" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Sort Order</label>
                <dataScope>sort_order</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
