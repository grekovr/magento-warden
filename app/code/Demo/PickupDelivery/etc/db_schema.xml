<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="demo_pickupdelivery_point"
           resource="default"
           engine="innodb"
           comment="Pickup Delivery Points">

        <column xsi:type="int"
                name="entity_id"
                unsigned="true"
                nullable="false"
                identity="true"
                comment="Entity ID"/>

        <column xsi:type="varchar"
                name="code"
                nullable="false"
                length="64"
                comment="Point Code"/>

        <column xsi:type="varchar"
                name="name"
                nullable="false"
                length="255"
                comment="Point Name"/>

        <column xsi:type="varchar"
                name="city"
                nullable="false"
                length="100"
                comment="City"/>

        <column xsi:type="varchar"
                name="address"
                nullable="false"
                length="255"
                comment="Address"/>

        <column xsi:type="boolean"
                name="is_active"
                nullable="false"
                default="1"
                comment="Is Active"/>

        <column xsi:type="int"
                name="sort_order"
                nullable="false"
                default="0"
                comment="Sort Order"/>

        <column xsi:type="datetime"
                name="created_at"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <column xsi:type="datetime"
                name="updated_at"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                comment="Updated At"/>

        <constraint xsi:type="primary"
                    referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <constraint xsi:type="unique"
                    referenceId="DEMO_PICKUPDELIVERY_POINT_CODE">
            <column name="code"/>
        </constraint>

        <index referenceId="DEMO_PICKUPDELIVERY_POINT_IS_ACTIVE"
               indexType="btree">
            <column name="is_active"/>
        </index>

    </table>
</schema>
