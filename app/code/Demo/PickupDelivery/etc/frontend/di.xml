<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="demo_pickupdelivery_checkout_layout_processor"
                type="Demo\PickupDelivery\Block\Checkout\LayoutProcessor"/>
    </type>

    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <arguments>
            <argument name="configProviders" xsi:type="array">
                <item name="demo_pickupdelivery_config_provider"
                      xsi:type="object">
                    Demo\PickupDelivery\Model\Checkout\PickupConfigProvider
                </item>
            </argument>
        </arguments>
    </type>

</config>
