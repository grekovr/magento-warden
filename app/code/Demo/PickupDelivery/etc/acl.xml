<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Demo_PickupDelivery::config"
                          title="Pickup Delivery Configuration"
                          translate="title"
                          sortOrder="10"/>

                <resource id="Demo_PickupDelivery::pickup_points"
                          title="Pickup Points"
                          translate="title"
                          sortOrder="20">
                    <resource id="Demo_PickupDelivery::pickup_points_view"
                              title="View Pickup Points"
                              translate="title"/>
                    <resource id="Demo_PickupDelivery::pickup_points_save"
                              title="Save Pickup Points"
                              translate="title"/>
                    <resource id="Demo_PickupDelivery::pickup_points_delete"
                              title="Delete Pickup Points"
                              translate="title"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
