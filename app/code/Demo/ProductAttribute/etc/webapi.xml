<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/candidate/product-attribute" method="POST">
        <service
            class="Demo\ProductAttribute\Api\ProductAttributeManagementInterface"
            method="getProductAttribute"/>
        <resources>
            <resource ref="Demo_ProductAttribute::product_attribute"/>
        </resources>
    </route>
</routes>
